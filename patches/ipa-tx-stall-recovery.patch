 /**
+ * ipa2_tx_dp_kick_stalled_pipe() - re-arm the Tx completion harvest for an
+ * egress client whose SPS EOT interrupt was lost.
+ *
+ * Replicates the SPS_EVENT_EOT branch of ipa_sps_irq_tx_notify() for @dst's
+ * system pipe. Called from the rmnet TX watchdog when the queue has stalled
+ * because outstanding_pkts is stuck at the high watermark: no EOT arrived to
+ * drain completed descriptors, so no harvest was scheduled, and with the
+ * queue stopped no further TX can produce a new EOT (a self-deadlock).
+ *
+ * AP-local: the harvest (ipa_handle_tx -> sps_get_iovec) only polls our own
+ * BAM pipe descriptor FIFO; it never touches modem-owned IPA state, so it
+ * cannot trip the XPU/TrustZone boundary. If the descriptors are genuinely
+ * complete (a lost EOT) the harvest drains them, decrements outstanding_pkts
+ * via each packet's completion callback, and wakes the queue. If the stall
+ * is modem-side (nothing completed) the harvest finds nothing and the pipe
+ * is left untouched.
+ *
+ * Return: 1 if a harvest was armed, 0 if a poll was already in progress,
+ * negative errno otherwise.
+ */
+int ipa2_tx_dp_kick_stalled_pipe(enum ipa_client_type dst)
+{
+	struct ipa_sys_context *sys;
+	int ipa_ep_idx;
+	int ret;
+
+	ipa_ep_idx = ipa2_get_ep_mapping(dst);
+	if (ipa_ep_idx == -1) {
+		IPAERR("invalid client %d\n", dst);
+		return -EINVAL;
+	}
+	if (!ipa_ctx->ep[ipa_ep_idx].valid) {
+		IPAERR("client %d pipe not set up\n", dst);
+		return -ENODEV;
+	}
+	sys = ipa_ctx->ep[ipa_ep_idx].sys;
+	if (!sys) {
+		IPAERR("client %d has no sys context\n", dst);
+		return -ENODEV;
+	}
+
+	/* The IPA clock may be gated (idle) when the watchdog fires; vote it
+	 * on for the reconfig. ipa_handle_tx() (queued below) takes its own
+	 * vote for the harvest itself.
+	 */
+	IPA_ACTIVE_CLIENTS_INC_SIMPLE();
+
+	/* A real EOT raced us and is already harvesting -- nothing to do. */
+	if (atomic_read(&sys->curr_polling_state)) {
+		IPA_ACTIVE_CLIENTS_DEC_SIMPLE();
+		return 0;
+	}
+
+	/* Same handshake ipa_sps_irq_tx_notify() runs on SPS_EVENT_EOT:
+	 * switch the pipe to POLL mode and arm the deferred harvest.
+	 */
+	ret = sps_get_config(sys->ep->ep_hdl, &sys->ep->connect);
+	if (ret) {
+		IPAERR("sps_get_config() failed %d\n", ret);
+		goto done;
+	}
+	sys->ep->connect.options =
+		SPS_O_AUTO_ENABLE | SPS_O_ACK_TRANSFERS | SPS_O_POLL;
+	ret = sps_set_config(sys->ep->ep_hdl, &sys->ep->connect);
+	if (ret) {
+		IPAERR("sps_set_config() failed %d\n", ret);
+		goto done;
+	}
+	atomic_set(&sys->curr_polling_state, 1);
+	queue_work(sys->wq, &sys->work);
+	ret = 1;
+done:
+	IPA_ACTIVE_CLIENTS_DEC_SIMPLE();
+	return ret;
+}

+/* TX-stall recovery state (AP-local watchdog harvest). */
+static int tx_stall_fails;		/* consecutive no-progress kicks */
+static int tx_stall_last_outstanding;	/* outstanding_pkts at the last kick */
+
+static void ipa_tx_stall_recover(struct work_struct *work)
+{
+	struct net_device *dev = ipa_netdevs[0];
+	struct wwan_private *wwan_ptr;
+	int before, rc;
+
+	if (!dev)
+		return;
+	wwan_ptr = netdev_priv(dev);
+	before = atomic_read(&wwan_ptr->outstanding_pkts);
+
+	/* AP-local: re-arm the Tx harvest the lost EOT would have run. Drains
+	 * any completed descriptors (decrementing outstanding_pkts via each
+	 * packet's completion callback and waking the queue); a harmless no-op
+	 * if the stall is modem-side. Never touches modem state -> no XPU/
+	 * hard-reset risk.
+	 */
+	rc = ipa2_tx_dp_kick_stalled_pipe(IPA_CLIENT_APPS_LAN_WAN_PROD);
+
+	/* The harvest is asynchronous; gauge progress against the previous
+	 * tick's count to back off on a genuine (modem-side) stall.
+	 */
+	if (rc == 1 && before == tx_stall_last_outstanding)
+		tx_stall_fails++;
+	else
+		tx_stall_fails = 0;
+	tx_stall_last_outstanding = before;
+
+	if (tx_stall_fails == 1 || (tx_stall_fails % 10) == 0)
+		IPAWANERR("[%s] UL stall: armed Tx harvest (outstanding=%d fails=%d)%s\n",
+			dev->name, before, tx_stall_fails,
+			tx_stall_fails >= IPA_TX_STALL_MODEM_THRESH ?
+			" -- looks modem-side, not AP-recoverable" : "");
+}
+
+static DECLARE_WORK(ipa_tx_stall_work, ipa_tx_stall_recover);
+
 static void ipa_wwan_tx_timeout(struct net_device *dev, unsigned int txqueue)
 {
 	IPAWANERR("[%s]:[%s] data stall in UL\n", __func__, dev->name);
+
+	/* SSR owns recovery while it runs; and stop hammering a dead modem. */
+	if (atomic_read(&is_ssr))
+		return;
+	if (tx_stall_fails >= IPA_TX_STALL_GIVEUP)
+		return;
+
+	/* Defer the harvest out of this timer context. */
+	schedule_work(&ipa_tx_stall_work);
 }
 

+	spec->route_table_index = 8;
+	spec->is_mux_id_valid = 1;
+	spec->mux_id = 1;
+	spec->filter_rule.rule_eq_bitmap = (1 << 2);
+	spec->filter_rule.num_offset_meq_32 = 1;
+	spec->filter_rule.offset_meq_32[0].offset = 24;

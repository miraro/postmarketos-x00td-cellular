+	pr_info("[WAN_DL_NOTIF] Sending FILTER_INSTALLED_NOTIF (6 handles) to modem Q6\n");
+	rc = qmi_filter_notify_send(req);
+	if (rc) {
+		pr_err("[WAN_DL_NOTIF] qmi_filter_notify_send FAILED rc=%d\n", rc);
+		kfree(req);
+		return rc;
+	}
